# Firebase Configuration
FIREBASE_API_KEY=your-api-key-here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Environment (development, staging, production)
NODE_ENV=development

# API Configuration
API_URL=http://localhost:5001/your-project-id/europe-west2/cms
API_PORT=5001
API_REGION=europe-west2

# Emulator Configuration
USE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FUNCTIONS_EMULATOR_HOST=localhost:5001
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# CMS UI Configuration
CMS_UI_PORT=8000

# CMS UI React Configuration
CMS_UI_REACT_PORT=3002

# Database Configuration
FIRESTORE_COLLECTION_PREFIX=

# Authentication
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password

# Logging
LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:8000

# AI Moderation (if applicable)
AI_MODERATION_ENABLED=false
AI_MODERATION_API_KEY=your-ai-api-key-here

# Stripe (if applicable for Phase 2)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Google Maps (if applicable)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key 